digraph TraditionalEcommerceERD {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad=0.35,
    nodesep=0.55,
    ranksep=0.85,
    splines=polyline,
    outputorder=edgesfirst,
    fontname="Arial"
  ];

  node [
    shape=plain,
    fontname="Arial"
  ];

  edge [
    color="#333333",
    arrowsize=0.8,
    fontname="Arial",
    fontsize=10
  ];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2f6f3e">
      <TR><TD BGCOLOR="#e7f4e7" COLSPAN="3"><B>users</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">google_id</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT">timestamp nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">remember_token</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  email_verification_otps [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#466b9f">
      <TR><TD BGCOLOR="#eaf1fb" COLSPAN="3"><B>email_verification_otps</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>IDX</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">otp</TD><TD ALIGN="LEFT">string(6)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  addresses [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b28b21">
      <TR><TD BGCOLOR="#fff5d9" COLSPAN="3"><B>addresses</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">address_line1</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">address_line2</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">pincode</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT">string default India</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_default</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  categories [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#a84868">
      <TR><TD BGCOLOR="#fbe8ef" COLSPAN="3"><B>categories</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  states [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7a4e9e">
      <TR><TD BGCOLOR="#f0e8fa" COLSPAN="3"><B>states</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  tribes [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7a4e9e">
      <TR><TD BGCOLOR="#f0e8fa" COLSPAN="3"><B>tribes</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">state_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  products [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2f6f3e">
      <TR><TD BGCOLOR="#e7f4e7" COLSPAN="3"><B>products</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">tribe_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">discount_price</TD><TD ALIGN="LEFT">decimal nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">stock</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">fabric</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">occasion</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_approved</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  product_images [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7a4e9e">
      <TR><TD BGCOLOR="#f0e8fa" COLSPAN="3"><B>product_images</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">image_path</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_primary</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  product_variants [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7a4e9e">
      <TR><TD BGCOLOR="#f0e8fa" COLSPAN="3"><B>product_variants</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">size</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">decimal nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">stock</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  carts [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#466b9f">
      <TR><TD BGCOLOR="#eaf1fb" COLSPAN="3"><B>carts</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">variant_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  wishlists [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2f96a2">
      <TR><TD BGCOLOR="#e4f7f9" COLSPAN="3"><B>wishlists</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  coupons [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b28b21">
      <TR><TD BGCOLOR="#fff5d9" COLSPAN="3"><B>coupons</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">min_order_amount</TD><TD ALIGN="LEFT">decimal nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">expiry_date</TD><TD ALIGN="LEFT">timestamp nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">usage_limit</TD><TD ALIGN="LEFT">integer nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">used_count</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  orders [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2f6f3e">
      <TR><TD BGCOLOR="#e7f4e7" COLSPAN="3"><B>orders</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">coupon_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">order_number</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">discount_amount</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">payment_method</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">payment_status</TD><TD ALIGN="LEFT">enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">payment_transaction_id</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">payment_UTR</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">shipping_address</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">shipping_address_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  order_items [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#466b9f">
      <TR><TD BGCOLOR="#eaf1fb" COLSPAN="3"><B>order_items</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">variant_id</TD><TD ALIGN="LEFT">bigint nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  reviews [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#b28b21">
      <TR><TD BGCOLOR="#fff5d9" COLSPAN="3"><B>reviews</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_approved</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  review_images [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#a84868">
      <TR><TD BGCOLOR="#fbe8ef" COLSPAN="3"><B>review_images</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">review_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">image_path</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  return_requests [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#a84868">
      <TR><TD BGCOLOR="#fbe8ef" COLSPAN="3"><B>return_requests</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">return_number</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">refund_amount</TD><TD ALIGN="LEFT">decimal nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">admin_notes</TD><TD ALIGN="LEFT">text nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">pickup_address</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">tracking_number</TD><TD ALIGN="LEFT">string nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">pickup_date</TD><TD ALIGN="LEFT">timestamp nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">refund_date</TD><TD ALIGN="LEFT">timestamp nullable</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>
  >];

  { rank=same; users; email_verification_otps; }
  { rank=same; states; tribes; categories; }
  { rank=same; carts; wishlists; orders; }

  users -> email_verification_otps [style=dashed, color="#777777", label="email match, no FK", taillabel="1", headlabel="0..N"];
  users -> addresses [label="user_id", taillabel="1", headlabel="N"];
  users -> carts [label="user_id", taillabel="1", headlabel="N"];
  users -> wishlists [label="user_id", taillabel="1", headlabel="N"];
  users -> orders [label="user_id", taillabel="1", headlabel="N"];
  users -> reviews [label="user_id", taillabel="1", headlabel="N"];
  users -> return_requests [label="user_id", taillabel="1", headlabel="N"];

  categories -> categories [label="parent_id", taillabel="1", headlabel="0..N"];
  categories -> products [label="category_id", taillabel="1", headlabel="0..N"];
  states -> tribes [label="state_id", taillabel="1", headlabel="N"];
  tribes -> products [label="tribe_id", taillabel="1", headlabel="0..N"];

  products -> product_images [label="product_id", taillabel="1", headlabel="N"];
  products -> product_variants [label="product_id", taillabel="1", headlabel="N"];
  products -> carts [label="product_id", taillabel="1", headlabel="N"];
  product_variants -> carts [label="variant_id", taillabel="1", headlabel="0..N"];
  products -> wishlists [label="product_id", taillabel="1", headlabel="N"];
  products -> order_items [label="product_id", taillabel="1", headlabel="N"];
  product_variants -> order_items [label="variant_id", taillabel="1", headlabel="0..N"];
  products -> reviews [label="product_id", taillabel="1", headlabel="N"];

  addresses -> orders [label="shipping_address_id", taillabel="1", headlabel="0..N"];
  coupons -> orders [label="coupon_id", taillabel="1", headlabel="0..N"];
  orders -> order_items [label="order_id", taillabel="1", headlabel="N"];
  orders -> return_requests [label="order_id", taillabel="1", headlabel="N"];
  reviews -> review_images [label="review_id", taillabel="1", headlabel="N"];
}
